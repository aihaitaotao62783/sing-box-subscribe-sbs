  "ntp": {
    "enabled": true,
    "interval": "2h",
    "server": "ntp.aliyun.com",
    "server_port": 123
  },

  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local"
      },

      {
        "tag": "hosts_fix",
        "type": "hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ]
        }
      },

      {
        "tag": "alidns",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts_fix"
      },

      {
        "tag": "txdns",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts_fix"
      },

      {
        "tag": "ggdns",
        "type": "https",
        "server": "dns.google",
        "domain_resolver": "hosts_fix",
        "detour": "Proxy"
      },

      {
        "tag": "ali-udp",
        "type": "udp",
        "server": "223.5.5.5"
      },

      {
        "tag": "tx-udp",
        "type": "udp",
        "server": "119.29.29.29"
      },

      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],

    "rules": [
      {
        "clash_mode": "direct",
        "action": "route",
        "server": "local"
      },

      {
        "clash_mode": "global",
        "action": "route",
        "server": "ggdns"
      },

      {
        "rule_set": "geosite-cn",
        "action": "route",
        "server": "local"
      },

      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "evaluate",
        "server": "alidns",
        "tag": "ali-response",
        "timeout": "3s"
      },

      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "match_response": "ali-response",
        "rule_set": "geoip-cn",
        "ip_accept_any": true,
        "action": "respond"
      },

      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip",
        "rewrite_ttl": 3600
      }
    ],

    "final": "ggdns",
    "strategy": "prefer_ipv4",
    "disable_cache": false,

    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    },

    "cache_capacity": 2048
  },

